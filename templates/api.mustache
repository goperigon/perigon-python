def _format_query_value(value: Any) -> str:
    """Format one query value for the Perigon API."""
    if isinstance(value, Enum):
        value = value.value
    if isinstance(value, datetime):
        if value.tzinfo is not None:
            value = value.astimezone(timezone.utc)
        return value.strftime("%Y-%m-%dT%H:%M:%S")
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def _normalise_query(params: Mapping[str, Any]) -> Dict[str, Any]:
    """
    • Convert Enum to its value
    • Format datetime as YYYY-MM-DDTHH:MM:SS in UTC, without an offset
    • Format bool as true/false
    • Keep list/tuple/set as a list so the key is repeated
    • Skip None values and empty collections
    """
    out: Dict[str, Any] = {}
    for key, value in params.items():
        if value is None:
            continue

        if isinstance(value, (list, tuple, set)):
            items = [_format_query_value(item) for item in value if item is not None]
            if items:
                out[key] = items
            continue

        out[key] = _format_query_value(value)

    return out


def _json_body(body: Any) -> Any:
    """Serialize a request model.

    Only fields the caller passed are included. An explicit null is kept so a
    PATCH can clear that field. Unset defaults are omitted. mode="json" converts
    datetime and UUID values, including inside nested models.
    """
    return body.model_dump(mode="json", by_alias=True, exclude_unset=True)

